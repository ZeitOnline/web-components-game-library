{
  "name": "@zeitonline/game-components",
  "version": "0.1.0",
  "description": "Framework-agnostic web components shared by ZEIT ONLINE games (Angular & SvelteKit).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeitOnline/web-components-game-library.git"
  },
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./button": {
      "types": "./src/index.d.ts",
      "default": "./src/components/zon-game-button.js"
    },
    "./dialog": {
      "types": "./src/index.d.ts",
      "default": "./src/components/zon-game-dialog.js"
    },
    "./instructions": {
      "types": "./src/index.d.ts",
      "default": "./src/components/zon-game-instructions.js"
    },
    "./timer": {
      "types": "./src/index.d.ts",
      "default": "./src/components/zon-game-timer.js"
    },
    "./result": {
      "types": "./src/index.d.ts",
      "default": "./src/components/zon-game-result.js"
    },
    "./hero": {
      "types": "./src/index.d.ts",
      "default": "./src/components/zon-game-hero.js"
    },
    "./puzzle-list": {
      "types": "./src/index.d.ts",
      "default": "./src/components/zon-puzzle-list.js"
    },
    "./faq": {
      "types": "./src/index.d.ts",
      "default": "./src/components/zon-game-faq.js"
    },
    "./tracking": {
      "types": "./src/index.d.ts",
      "default": "./src/tracking.js"
    },
    "./navigation": {
      "types": "./src/index.d.ts",
      "default": "./src/components/zon-game-navigation.js"
    },
    "./feedback-button": {
      "types": "./src/index.d.ts",
      "default": "./src/components/zon-game-feedback-button.js"
    },
    "./critical.css": "./src/critical.css"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "./src/components/*.js",
    "./src/index.js",
    "*.css"
  ],
  "scripts": {
    "dev": "npm --prefix demo run dev",
    "build:demo": "npm --prefix demo run build",
    "preview:demo": "npm --prefix demo run preview"
  },
  "private": true,
  "types": "src/index.d.ts"
}
