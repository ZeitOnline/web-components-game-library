{
  "name": "@zeitonline/game-components",
  "version": "0.2.0",
  "description": "Framework-agnostic web components shared by ZEIT ONLINE games (Angular & SvelteKit). Written in TypeScript, built to dist/ on install.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeitOnline/web-components-game-library.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/zon-game-button.d.ts",
      "default": "./dist/components/zon-game-button.js"
    },
    "./dialog": {
      "types": "./dist/components/zon-game-dialog.d.ts",
      "default": "./dist/components/zon-game-dialog.js"
    },
    "./instructions": {
      "types": "./dist/components/zon-game-instructions.d.ts",
      "default": "./dist/components/zon-game-instructions.js"
    },
    "./timer": {
      "types": "./dist/components/zon-game-timer.d.ts",
      "default": "./dist/components/zon-game-timer.js"
    },
    "./result": {
      "types": "./dist/components/zon-game-result.d.ts",
      "default": "./dist/components/zon-game-result.js"
    },
    "./hero": {
      "types": "./dist/components/zon-game-hero.d.ts",
      "default": "./dist/components/zon-game-hero.js"
    },
    "./puzzle-list": {
      "types": "./dist/components/zon-puzzle-list.d.ts",
      "default": "./dist/components/zon-puzzle-list.js"
    },
    "./faq": {
      "types": "./dist/components/zon-game-faq.d.ts",
      "default": "./dist/components/zon-game-faq.js"
    },
    "./tracking": {
      "types": "./dist/tracking.d.ts",
      "default": "./dist/tracking.js"
    },
    "./navigation": {
      "types": "./dist/components/zon-game-navigation.d.ts",
      "default": "./dist/components/zon-game-navigation.js"
    },
    "./feedback-button": {
      "types": "./dist/components/zon-game-feedback-button.d.ts",
      "default": "./dist/components/zon-game-feedback-button.js"
    },
    "./critical.css": "./src/critical.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./dist/components/*.js",
    "./dist/index.js",
    "*.css"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "npm --prefix demo run dev",
    "build:demo": "npm --prefix demo run build",
    "preview:demo": "npm --prefix demo run preview"
  },
  "private": true,
  "types": "dist/index.d.ts",
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
